# Recommended: serverless proxy (see worker/README.md). When the URL is set,
# the app needs no user-provided API keys at all.
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_AI_PROXY_APP_KEY=

# Fallback mode: bring-your-own keys (only used when the proxy URL is empty)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_key_here
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_key_here
EXPO_PUBLIC_GROQ_API_KEY=your_groq_key_here

