# Recommended: serverless proxy (see worker/README.md). When the URL is set,
# the app needs no user-provided API keys at all.
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_AI_PROXY_APP_KEY=

# Dev-only fallback (used only when the proxy URL is empty).
# WARNING: EXPO_PUBLIC_* values are baked into the app bundle and extractable
# by anyone — never put a real shared key here. For personal testing, enter
# keys in the app's Settings screen (stored in expo-secure-store) instead.
#EXPO_PUBLIC_GEMINI_API_KEY=
#EXPO_PUBLIC_OPENROUTER_API_KEY=
#EXPO_PUBLIC_GROQ_API_KEY=